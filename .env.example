# Generate real secrets with scripts/configure_local.py; never commit .env.
MANIM_BASE_URL=http://127.0.0.1:8787
MANIM_API_KEY=replace-with-at-least-32-random-characters
MANIM_SIGNING_KEY=replace-with-an-independent-random-secret
MANIM_RUNTIME=podman
MANIM_WORKER_IMAGE=localhost/chatgpt-manim-worker:0.1.0
MANIM_DATA_DIR=data
# Remote OAuth: configure a real OAuth 2.1 provider with PKCE and MCP discovery.
# MANIM_OAUTH_ISSUER=https://your-identity-provider.example/
# MANIM_OAUTH_AUDIENCE=https://your-service.example/mcp
# MANIM_OAUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
